+    // sts2bot: the scans below walk the whole scene tree three or four times, 24 of every 27 ms a state took (2026-11-25), and
+    // a combat state is asked for every few dozen ms. A scan that found nothing is trusted for PopupScanMs of real time; any
+    // action sent clears it (an action is what opens a popup), so a popup shows by the next look after it or within that time.
+    internal static long NoPopupUntilMs;
+    private const long PopupScanMs = 200;
+
     private static Dictionary<string, object?>? BuildVisibleFtueState(Node root)
+    {
+        long now = System.Environment.TickCount64;
+        if (now < NoPopupUntilMs)
+            return null;
+        var found = ScanVisibleFtueState(root);
+        if (found == null)
+            NoPopupUntilMs = now + PopupScanMs;
+        return found;
+    }
