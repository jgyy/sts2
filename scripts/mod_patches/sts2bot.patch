+/// <summary>Where a state request's time goes on the main thread (sts2bot): section totals, printed every 400 builds.</summary>
+internal static class Prof
+{
+    private static readonly Dictionary<string, double[]> _t = new();
+    private static int _builds;
+
+    internal static T Time<T>(string key, Func<T> f)
+    {
+        var sw = System.Diagnostics.Stopwatch.StartNew();
+        try { return f(); }
+        finally { Add(key, sw.Elapsed.TotalMilliseconds); }
+    }
+
+    internal static void Add(string key, double ms)
+    {
+        if (!_t.TryGetValue(key, out var v)) _t[key] = v = new double[3];
+        v[0] += ms; v[1] += 1; v[2] = Math.Max(v[2], ms);
+    }
+
+    internal static Dictionary<string, object?> Build(Func<Dictionary<string, object?>> build)
+    {
+        var state = Time("build", build);
+        if (++_builds % 400 == 0)
+        {
+            var sb = new StringBuilder("[STS2 MCP] state build ms over 400 (total/calls, mean, max): ");
+            foreach (var kv in _t)
+                sb.Append($"{kv.Key} {kv.Value[0]:F0}/{kv.Value[1]:F0} {kv.Value[0] / Math.Max(1, kv.Value[1]):F2} {kv.Value[2]:F1}; ");
+            GD.Print(sb.ToString());
+            _t.Clear();
+        }
+        return state;
+    }
+}
