     {
         var tutorialFtue = FindVisibleAcceptTutorialsFtue(root);
         if (tutorialFtue != null && IsFtueNodeActive(tutorialFtue))
diff --git a/McpMod.Modes.cs b/McpMod.Modes.cs
new file mode 100644
index 0000000..3ed18cf
--- /dev/null
+++ b/McpMod.Modes.cs
@@ -0,0 +1,71 @@
+using System;
+using System.Collections.Generic;
+using Godot;
+using MegaCrit.Sts2.Core.Entities.Merchant;
+using MegaCrit.Sts2.Core.Multiplayer.Game.Lobby;
+using MegaCrit.Sts2.Core.Nodes.GodotExtensions;
+using MegaCrit.Sts2.Core.Nodes.Screens.Blitz;
+using MegaCrit.Sts2.Core.Nodes.Screens.CharacterSelect;
+using MegaCrit.Sts2.Core.Nodes.Screens.Dread;
+
+namespace STS2_MCP;
+
+// sts2bot: Blitz and Dread. Their menus are screens of their own (not NCharacterSelectScreen), laid out alike: the same
+// character buttons, _embarkButton, _backButton and _lobby. A first visit puts an information panel over the screen.
+public static partial class McpMod
+{
+    /// <summary>The character select of any mode that is on screen, or null.</summary>
+    private static Control? FindModeScreen(Node root)
+    {
+        Control? screen = FindFirst<NCharacterSelectScreen>(root);
+        if (screen != null && IsNodeVisible(screen))
+            return screen;
+        screen = FindFirst<NBlitzScreen>(root);
+        if (screen != null && IsNodeVisible(screen))
+            return screen;
+        screen = FindFirst<NDreadScreen>(root);
+        return screen != null && IsNodeVisible(screen) ? screen : null;
+    }
+
+    private static string ModeOf(Control screen) =>
+        screen is NBlitzScreen ? "blitz" : screen is NDreadScreen ? "dread" : "standard";
+
+    private static StartRunLobby? LobbyOf(Control screen) =>
+        screen is NCharacterSelectScreen select ? select.Lobby : GetInstanceFieldValue(screen, "_lobby") as StartRunLobby;
+
+    /// <summary>The button that closes the Blitz or Dread information panel, if one is up.</summary>
+    private static NClickableControl? FindModeDisclaimerConfirm(Node root)
+    {
+        Control? panel = FindFirst<NBlitzInfoDisclaimer>(root);
+        if (panel == null || !IsNodeVisible(panel))
+            panel = FindFirst<NDreadInfoDisclaimer>(root);
+        if (panel == null || !IsNodeVisible(panel))
+            return null;
+        return GetInstanceFieldValue(panel, "_confirmButton") as NClickableControl;
+    }
+
+    // The Blitz shop: a few picks, no gold. Its entries follow the (empty) cards, relics and potions in AllEntries, so
+    // the index here is the one shop_purchase takes.
+    private static void AddBlitzShopState(Dictionary<string, object?> state, MerchantInventory inventory, List<Dictionary<string, object?>> items)
+    {
+        if (!inventory.IsBlitzShop)
+            return;
+        int index = items.Count;
+        foreach (var entry in inventory.BlitzEntries)
+        {
+            items.Add(new Dictionary<string, object?>
+            {
+                ["index"] = index++,
+                ["category"] = "blitz",
+                ["blitz_type"] = entry.MerchantEntryType.ToString(),
+                ["name"] = SafeGetText(() => entry.Title),
+                ["description"] = SafeGetText(() => entry.Description),
+                ["cursed"] = entry.IsCursed,
+                ["price"] = 0,
+                ["is_stocked"] = entry.IsStocked,
+                ["can_afford"] = true
