diff --git a/McpMod.CrashGuards.cs b/McpMod.CrashGuards.cs
new file mode 100644
index 0000000..72c1f84
--- /dev/null
+++ b/McpMod.CrashGuards.cs
@@ -0,0 +1,160 @@
+using System;
+using System.Threading.Tasks;
+using Godot;
+using HarmonyLib;
+
+namespace STS2_MCP;
+
+public static partial class McpMod
+{
+    // The Punch Off event opens with two creatures punching each other in a
+    // visual-only combat room. In game v0.111 that animation crashes the game
+    // natively every time (Signal '_internal_spine_objects_invalidated' is
+    // already connected, then a crash in MegaSpine SetAnimation), on entering
+    // the event and again on every resume of the save. Skipping the animation
+    // leaves the event itself as it is.
+    private static void TryApplyCrashGuards()
+    {
+        var harmony = new Harmony("com.sts2mcp.crashguards");
+        try
+        {
+            var type = AccessTools.TypeByName("MegaCrit.Sts2.Core.Models.Events.PunchOff");
+            var method = type == null ? null : AccessTools.Method(type, "PunchEachOther");
+            if (method == null)
+            {
+                GD.Print("[STS2 MCP] Crash guard skipped: PunchOff.PunchEachOther not found");
+            }
+            else
+            {
+                harmony.Patch(method, prefix: new HarmonyMethod(typeof(McpMod), nameof(SkipPunchOffAnimation)));
+                GD.Print("[STS2 MCP] Crash guard on: Punch Off animation is skipped");
+            }
+        }
+        catch (Exception ex)
+        {
+            GD.Print($"[STS2 MCP] Crash guard skipped: {ex.GetType().Name}: {ex.Message}");
+        }
+
+        // The merchant's dialogue for a purchase that failed throws for a status it has no
+        // lines for (ArgumentOutOfRangeException in MerchantDialogueSet.GetPurchaseSuccessLines,
+        // "Actual value was FailureOutOfStock"). The relic Lord's Parasol buys the whole shelf in
+        // a loop of its own; when one item on it is already gone, that exception comes out of
+        // LordsParasol.PurchaseEverything and the game dies, at the shop door of the save, on
+        // every resume. A line of dialogue is not worth that: the exception is dropped.
+        foreach (var name in new[] { "ShowForPurchaseAttempt" })
+        {
+            try
+            {
+                var type = AccessTools.TypeByName("MegaCrit.Sts2.Core.Nodes.Screens.Shops.NMerchantDialogue");
+                var method = type == null ? null : AccessTools.Method(type, name);
+                if (method == null)
+                {
+                    GD.Print($"[STS2 MCP] Crash guard skipped: NMerchantDialogue.{name} not found");
+                    continue;
+                }
+                harmony.Patch(method, finalizer: new HarmonyMethod(typeof(McpMod), nameof(DropException)));
+                GD.Print($"[STS2 MCP] Crash guard on: merchant dialogue ({name}) cannot throw");
+            }
+            catch (Exception ex)
+            {
+                GD.Print($"[STS2 MCP] Crash guard skipped: {ex.GetType().Name}: {ex.Message}");
+            }
+        }
+
+        // A card flying to a pile leaves a trail (NCardTrail, a Line2D): CreatePoint fills the gap to
+        // the last point with one point every 48 pixels, `for (d = 48f; d < dist - 12f; d += 48f)`.
+        // When the card's position is infinite (or so far off that a float no longer moves by 48)
+        // that loop never ends: the list grows until "OutOfMemoryException: Array dimensions exceeded
+        // supported range" and the game stands still, answering pings and nothing else (2026-11-28
+        // 10:21, a Ceremonial Beast fight at 16 times the clock). Such a point is left out.
+        try
+        {
+            var type = AccessTools.TypeByName("MegaCrit.Sts2.Core.Nodes.Vfx.NCardTrail");
+            var method = type == null ? null : AccessTools.Method(type, "CreatePoint");
+            if (method == null)
+            {
+                GD.Print("[STS2 MCP] Crash guard skipped: NCardTrail.CreatePoint not found");
+            }
+            else
+            {
+                harmony.Patch(method, prefix: new HarmonyMethod(typeof(McpMod), nameof(SkipWildTrailPoint)));
+                GD.Print("[STS2 MCP] Crash guard on: card trails skip points out of range");
+            }
+        }
+        catch (Exception ex)
+        {
+            GD.Print($"[STS2 MCP] Crash guard skipped: {ex.GetType().Name}: {ex.Message}");
+        }
+
+        // These screens ease positions with Lerp(from, to, delta * k), k = 4 to 36, with no upper bound,
+        // and delta is the frame's time on the game clock: at 16 times the clock a frame slower than
+        // 1/96 s makes delta * 12 > 2, every step overshoots by more than it was off, and the position
+        // runs away to infinity and NaN. The card grid then reallocates a row it does not have and the
+        // game dies (ArgumentOutOfRangeException in NCardGrid.ReallocateAbove: 6 of the crash dumps of
+        // 26-28 November 2026, among them Brain Leech's five-card screen). For these nodes only, a
+        // frame's step is at most that of a 30 fps game at normal speed.
+        int capped = 0;
+        foreach (var name in new[]
+        {
+            "Cards.NCardGrid", "GodotExtensions.NScrollableContainer", "CommonUi.NDropdownContainer",
+            "Screens.NRewardsScreen", "Screens.Map.NMapScreen", "Screens.Shops.NMerchantHand",
+            "Screens.Timeline.NSlotsContainer", "Vfx.NSovereignBladeVfx", "Combat.NTargetingArrow",
+        })
+        {
+            try
+            {
+                var type = AccessTools.TypeByName("MegaCrit.Sts2.Core.Nodes." + name);
+                var method = type == null ? null : AccessTools.DeclaredMethod(type, "_Process");
+                if (method == null)
+                {
+                    GD.Print($"[STS2 MCP] Crash guard skipped: {name}._Process not found");
+                    continue;
+                }
+                harmony.Patch(method, prefix: new HarmonyMethod(typeof(McpMod), nameof(CapFrameStep)));
+                capped++;
+            }
+            catch (Exception ex)
+            {
+                GD.Print($"[STS2 MCP] Crash guard skipped: {ex.GetType().Name}: {ex.Message}");
+            }
+        }
+        GD.Print($"[STS2 MCP] Crash guard on: frame step capped on {capped} easing nodes");
+    }
+
+    private const double MaxFrameStep = 1.0 / 30.0;
+
+    private static void CapFrameStep(ref double delta)
+    {
+        if (delta > MaxFrameStep)
+            delta = MaxFrameStep;
+    }
+
+    private const float TrailRange = 100000f;
+    private static bool _wildTrailSeen;
+
+    // False (the point is not made) unless both coordinates are finite and within TrailRange.
+    private static bool SkipWildTrailPoint(Vector2 pointPos)
+    {
+        bool sane = float.IsFinite(pointPos.X) && float.IsFinite(pointPos.Y)
+            && Math.Abs(pointPos.X) < TrailRange && Math.Abs(pointPos.Y) < TrailRange;
+        if (!sane && !_wildTrailSeen)
+        {
+            _wildTrailSeen = true;
+            GD.Print($"[STS2 MCP] Crash guard: card trail point out of range ({pointPos.X}, {pointPos.Y}) left out");
+        }
+        return sane;
+    }
+
+    private static Exception? DropException(Exception? __exception)
+    {
+        if (__exception != null)
+            GD.Print($"[STS2 MCP] Crash guard: dropped {__exception.GetType().Name}: {__exception.Message}");
+        return null;
+    }
+
+    private static bool SkipPunchOffAnimation(ref Task __result)
+    {
+        __result = Task.CompletedTask;
+        return false;
+    }
+}
