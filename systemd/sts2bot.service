# User service that keeps the bot (and through it, the game) running 24/7.
#
#   mkdir -p ~/.config/systemd/user
#   sed "s|@REPO@|$PWD|" systemd/sts2bot.service > ~/.config/systemd/user/sts2bot.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now sts2bot
#   journalctl --user -u sts2bot -f
#
# To turn it off: python3 -m sts2bot service disable (see the README, "Running 24/7").
#
# The bot starts Steam itself if it is not running (Steam must be able to log in unattended).
#
# To play the first Slay the Spire instead, add --game sts1 at the end of ExecStart (one game at a time).

[Unit]
Description=Slay the Spire 2 bot
After=graphical-session.target
PartOf=graphical-session.target

[Service]
WorkingDirectory=@REPO@
# systemd-inhibit keeps the machine from idling to sleep while the bot plays.
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep --who=sts2bot --why="Playing Slay the Spire 2" /usr/bin/python3 -m sts2bot
Restart=always
RestartSec=15

[Install]
WantedBy=graphical-session.target
